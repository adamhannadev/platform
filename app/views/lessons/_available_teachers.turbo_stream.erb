<!-- filepath: /home/adam/projects/platform/app/views/lessons/_available_teachers.turbo_stream.erb -->
<turbo-stream target="teacher-step" action="replace">
  <template>
    <h2>Choose an Instructor</h2>
    <div>
      <% teachers.each do |teacher| %>
        <button class="btn btn-accent m-1"
          data-action="click->booking#selectTeacher"
          data-teacher-id="<%= teacher.id %>"
          data-date="<%= params[:date] %>"
          data-location-id="<%= params[:location_id] %>">
          <%= teacher.full_name %>
        </button>
      <% end %>
    </div>
  </template>
</turbo-stream>