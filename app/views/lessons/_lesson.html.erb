<div id="<%= dom_id lesson %>">
  <p>
    <strong>Lesson time:</strong>
    <%= lesson.start_time %>
  </p>

  <p>
    <strong>Student:</strong>
    <%= lesson.student_id %>
  </p>

  <p>
    <strong>Teacher:</strong>
    <%= lesson.teacher_id %>
  </p>

  <p>
    <strong>Plan:</strong>
    <%= lesson.plan %>
  </p>

</div>
