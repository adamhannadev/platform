<turbo-stream target="calendar-step" action="replace" method="morph">
  <template>
    <h2>Choose a Day</h2>
    <div>
      <% days.each do |day| %>
        <button class="btn btn-accent m-1"
          data-action="click->booking#selectDay"
          data-date="<%= day %>"
          data-location-id="<%= params[:location_id] %>">
          <%= day.strftime("%b %d") %>
        </button>
      <% end %>
    </div>
  </template>
</turbo-stream>