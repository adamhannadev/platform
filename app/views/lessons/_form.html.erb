<%= form_with(model: lesson) do |form| %>
  <% if lesson.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(lesson.errors.count, "error") %> prohibited this lesson from being saved:</h2>

      <ul>
        <% lesson.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :start_time, style: "display: block" %>
    <%= form.datetime_field :start_time %>
  </div>

  <div>
    <%= form.label :student_id, style: "display: block" %>
    <%= form.collection_select :student_id, Student.all, :id, :full_name, prompt: "Select a student" %>
 
  </div>

  <div>
    <%= form.label :teacher_id, style: "display: block" %>
     <%= form.collection_select :teacher_id, Teacher.all, :id, :full_name, prompt: "Select a teacher" %>
 
  </div>

  <div>
    <%= form.label :plan, style: "display: block" %>
    <%= form.text_area :plan %>
  </div>

  <div>
    <%= form.label :location_id %>
    <%= form.collection_select :location_id, Location.all, :id, :name, prompt: "Select a location" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
