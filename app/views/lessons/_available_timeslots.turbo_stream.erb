<!-- filepath: /home/adam/projects/platform/app/views/lessons/_available_timeslots.turbo_stream.erb -->
<turbo-stream target="timeslot-step" action="replace">
  <template>
    <h2>Choose a Timeslot</h2>
    <div>
      <% timeslots.each do |slot| %>
        <button class="btn btn-accent m-1"
          data-action="click->booking#bookTimeslot"
          data-teacher-id="<%= params[:teacher_id] %>"
          data-location-id="<%= params[:location_id] %>"
          data-start-time="<%= slot %>">
          <%= slot.strftime("%H:%M") %>
        </button>
      <% end %>
    </div>
  </template>
</turbo-stream>