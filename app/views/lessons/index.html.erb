<p style="color: green"><%= notice %></p>

<% content_for :title, "Lessons" %>

<h1>Lessons</h1>

<table class="tbl">
  <thead>
    <th>Start Time</th>
    <th>Teacher</th>
    <th>Student</th>
    <th>Plan</th>
    <th></th>
    <th></th>
  </thead>
  <tbody>
    <% @lessons.each do |l| %>
      <tr>
        <td><%= l.start_time.strftime("%b %d, %Y - %I:%M %p") %></td>
        <td><%= l.student.full_name %></td>
        <td><%= l.teacher.full_name %></td>
        <td><%= l.plan %></td>
        <td><%= button_to "Edit", edit_lesson_path(l), method: :get, class: "btn" %></td>
        <td>
          <%= button_to "Delete", lesson_path(l), method: :delete, data: { confirm: "Are you sure?" }, class: "btn" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "New lesson", new_lesson_path %>
