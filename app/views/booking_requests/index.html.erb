<% content_for :title, "My Booking Requests" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>My Booking Requests</h1>
  <%= link_to "Request New Lesson", new_booking_request_path, class: "btn btn-primary" %>
</div>

<% if @booking_requests.any? %>
  <div class="row">
    <% @booking_requests.each do |request| %>
      <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold"><%= request.teacher.full_name %></span>
            <span class="badge bg-<%= request.status == 'pending' ? 'warning text-dark' : 
                                    request.status == 'approved' ? 'success' : 'danger' %>">
              <%= request.status.titleize %>
            </span>
          </div>
          <div class="card-body">
            <h6 class="card-title"><%= request.location.name %></h6>
            <p class="card-text">
              <strong><%= request.requested_date.strftime('%A, %B %-d') %></strong><br>
              <%= request.requested_time.strftime('%-I:%M %p') %> 
              (<%= request.duration %> min)
            </p>
            
            <% if request.notes.present? %>
              <p class="card-text text-muted small">
                <%= truncate(request.notes, length: 100) %>
              </p>
            <% end %>
            
            <div class="mt-auto">
              <small class="text-muted">
                Requested <%= time_ago_in_words(request.created_at) %> ago
              </small>
            </div>
          </div>
          <div class="card-footer bg-transparent">
            <div class="d-flex justify-content-between">
              <%= link_to "View Details", booking_request_path(request), 
                          class: "btn btn-sm btn-outline-primary" %>
              
              <% if request.status == 'pending' %>
                <%= button_to "Cancel", cancel_booking_request_path(request), 
                              method: :patch,
                              class: "btn btn-sm btn-outline-danger",
                              data: { confirm: "Are you sure you want to cancel this request?" } %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  
  <!-- Status Summary -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <h6 class="card-title">Request Summary</h6>
          <div class="row text-center">
            <div class="col-md-3">
              <div class="border-end">
                <h4 class="text-warning"><%= @booking_requests.where(status: 'pending').count %></h4>
                <small class="text-muted">Pending</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="border-end">
                <h4 class="text-success"><%= @booking_requests.where(status: 'approved').count %></h4>
                <small class="text-muted">Approved</small>
              </div>
            </div>
            <div class="col-md-3">
              <div class="border-end">
                <h4 class="text-danger"><%= @booking_requests.where(status: 'rejected').count %></h4>
                <small class="text-muted">Rejected</small>
              </div>
            </div>
            <div class="col-md-3">
              <h4 class="text-info"><%= @booking_requests.where(status: 'cancelled').count %></h4>
              <small class="text-muted">Cancelled</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <div class="text-center py-5">
    <div class="mb-4">
      <i class="fas fa-calendar-plus fa-4x text-muted"></i>
    </div>
    <h3 class="text-muted">No Booking Requests Yet</h3>
    <p class="text-muted mb-4">You haven't made any lesson booking requests yet.</p>
    <%= link_to "Request Your First Lesson", new_booking_request_path, 
                class: "btn btn-primary btn-lg" %>
  </div>
<% end %>
