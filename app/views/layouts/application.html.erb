<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<style>
      body {
        background-color: #f6f0fa;
      }
      .main-container {
        background: #fff;
        border-radius: 1rem;
        box-shadow: 0 2px 16px rgba(120, 72, 180, 0.08);
        padding: 2rem;
        margin-top: 2rem;
        margin-bottom: 2rem;
        border: 2px solid #e6d6f7;
      }
      .accent {
        color: #7c3aed;
      }
      .btn-accent {
        background-color: #e6d6f7;
        color: #7c3aed;
        border: none;
      }
      .btn-accent:hover {
        background-color: #d1b3ee;
        color: #fff;
      }
    </style>
  </head>

<body>
  <% if user_signed_in? %>
  <!-- Topbar -->
  <nav class="navbar navbar-expand-lg navbar-light" style="background-color: #e6d6f7;">
    <div class="container-fluid">
      <a class="navbar-brand accent" href="#">Platform</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <%= link_to "Lessons", lessons_path, class: "nav-link accent" %>
          </li>
          <li class="nav-item">
            <%= link_to "Teachers", teachers_path, class: "nav-link accent" %>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  <% end %>

  <div class="main_container container d-flex justify-content-center <%= 'align-items-center' unless user_signed_in? %>" style="height: 100vh;">
    <div class="content"><%= yield %></div>
  </div>

  <!-- Toast container -->
<div id="toast-container" style="position: fixed; top: 1rem; right: 1rem; z-index: 1055;"></div>
</body>
</html>