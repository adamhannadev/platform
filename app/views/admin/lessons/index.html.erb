<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Lesson Management</h1>
        <%= link_to "New Lesson", new_admin_lesson_path, class: "btn btn-primary" %>
      </div>

      <!-- Filters Card -->
      <div class="card mb-4">
        <div class="card-header">
          <h6>Filters</h6>
        </div>
        <div class="card-body">
          <%= form_with url: admin_lessons_path, method: :get, local: true, class: "row g-3" do |form| %>
            <div class="col-md-3">
              <%= form.label :teacher_id, "Teacher", class: "form-label" %>
              <%= form.select :teacher_id, 
                              options_from_collection_for_select(@teachers, :id, :name, params[:teacher_id]),
                              { prompt: "All Teachers" }, 
                              { class: "form-select" } %>
            </div>
            <div class="col-md-3">
              <%= form.label :student_id, "Student", class: "form-label" %>
              <%= form.select :student_id, 
                              options_from_collection_for_select(@students, :id, :full_name, params[:student_id]),
                              { prompt: "All Students" }, 
                              { class: "form-select" } %>
            </div>
            <div class="col-md-3">
              <%= form.label :location_id, "Location", class: "form-label" %>
              <%= form.select :location_id, 
                              options_from_collection_for_select(@locations, :id, :name, params[:location_id]),
                              { prompt: "All Locations" }, 
                              { class: "form-select" } %>
            </div>
            <div class="col-md-3">
              <%= form.label :date_from, "From Date", class: "form-label" %>
              <%= form.date_field :date_from, value: params[:date_from], class: "form-control" %>
            </div>
            <div class="col-md-3">
              <%= form.label :date_to, "To Date", class: "form-label" %>
              <%= form.date_field :date_to, value: params[:date_to], class: "form-control" %>
            </div>
            <div class="col-md-3 d-flex align-items-end">
              <%= form.submit "Filter", class: "btn btn-outline-primary me-2" %>
              <%= link_to "Clear", admin_lessons_path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Stats Cards -->
      <div class="row mb-4">
        <div class="col-md-3">
          <div class="card text-center">
            <div class="card-body">
              <h5 class="card-title"><%= @lessons.count %></h5>
              <p class="card-text text-muted">Total Lessons</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-center">
            <div class="card-body">
              <h5 class="card-title"><%= @lessons.where('start_time > ?', Time.current).count %></h5>
              <p class="card-text text-muted">Upcoming</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-center">
            <div class="card-body">
              <h5 class="card-title"><%= @lessons.where('start_time >= ? AND start_time <= ?', Date.current.beginning_of_day, Date.current.end_of_day).count %></h5>
              <p class="card-text text-muted">Today</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-center">
            <div class="card-body">
              <h5 class="card-title"><%= @lessons.where('start_time < ?', Time.current).count %></h5>
              <p class="card-text text-muted">Completed</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Lessons Table -->
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5>Lessons</h5>
          <span class="badge bg-secondary"><%= @lessons.count %> lessons</span>
        </div>
        <div class="card-body">
          <% if @lessons.any? %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Date & Time</th>
                    <th>Student</th>
                    <th>Teacher</th>
                    <th>Location</th>
                    <th>Duration</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @lessons.each do |lesson| %>
                    <tr>
                      <td>
                        <div>
                          <strong><%= lesson.start_time.strftime("%m/%d/%Y") %></strong>
                        </div>
                        <small class="text-muted"><%= lesson.start_time.strftime("%I:%M %p") %></small>
                      </td>
                      <td>
                        <%= link_to lesson.student.full_name, admin_student_path(lesson.student), 
                                    class: "text-decoration-none" %>
                        <br>
                        <small class="text-muted"><%= lesson.student.email %></small>
                      </td>
                      <td>
                        <%= link_to lesson.teacher.name, admin_teacher_path(lesson.teacher), 
                                    class: "text-decoration-none" %>
                      </td>
                      <td>
                        <%= link_to lesson.location.name, admin_location_path(lesson.location), 
                                    class: "text-decoration-none" %>
                      </td>
                      <td>
                        <span class="badge bg-info"><%= lesson.duration %> min</span>
                      </td>
                      <td>
                        <% if lesson.start_time > Time.current %>
                          <span class="badge bg-success">Upcoming</span>
                        <% elsif lesson.start_time + lesson.duration.minutes < Time.current %>
                          <span class="badge bg-secondary">Completed</span>
                        <% else %>
                          <span class="badge bg-warning">In Progress</span>
                        <% end %>
                      </td>
                      <td>
                        <div class="btn-group" role="group">
                          <%= link_to "View", admin_lesson_path(lesson), 
                                      class: "btn btn-sm btn-outline-primary" %>
                          <%= link_to "Edit", edit_admin_lesson_path(lesson), 
                                      class: "btn btn-sm btn-outline-secondary" %>
                          <%= link_to "Delete", admin_lesson_path(lesson), 
                                      method: :delete, 
                                      confirm: "Are you sure you want to delete this lesson?", 
                                      class: "btn btn-sm btn-outline-danger" %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <i class="fas fa-calendar-alt fa-3x text-muted mb-3"></i>
              <h5>No lessons found</h5>
              <p class="text-muted">
                <% if params[:teacher_id].present? || params[:student_id].present? || params[:location_id].present? || params[:date_from].present? || params[:date_to].present? %>
                  Try adjusting your filters or <%= link_to "clear all filters", admin_lessons_path, class: "text-decoration-none" %>.
                <% else %>
                  Get started by <%= link_to "creating your first lesson", new_admin_lesson_path, class: "text-decoration-none" %>.
                <% end %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
