<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
          <i class="fas fa-user-tie me-2"></i>
          Teacher Availability
        </h1>
        <div class="btn-group" role="group">
          <%= link_to "Add Teacher Availability", new_teacher_availability_admin_availabilities_path, 
                      class: "btn btn-primary" %>
          <%= link_to "Location Availability", location_availability_admin_availabilities_path, 
                      class: "btn btn-success" %>
          <%= link_to "Back to Availability", admin_availabilities_path, 
                      class: "btn btn-outline-secondary" %>
        </div>
      </div>

      <!-- Teachers List -->
      <div class="row">
        <% @teachers.each do |teacher| %>
          <div class="col-lg-6 mb-4">
            <div class="card">
              <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                  <%= teacher.name %>
                  <span class="badge bg-info ms-2">
                    <%= teacher.availabilities.count %> slots
                  </span>
                </h5>
                <%= link_to "Add Availability", new_teacher_availability_admin_availabilities_path(teacher_id: teacher.id), 
                            class: "btn btn-sm btn-primary" %>
              </div>
              <div class="card-body">
                <% if teacher.availabilities.any? %>
                  <div class="table-responsive">
                    <table class="table table-sm">
                      <thead>
                        <tr>
                          <th>Date & Time</th>
                          <th>Status</th>
                          <th>Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% teacher.availabilities.order(:start_time).each do |availability| %>
                          <tr>
                            <td>
                              <div>
                                <strong><%= availability.start_time.strftime('%A, %B %d, %Y') %></strong>
                              </div>
                              <small class="text-muted">
                                <%= availability.start_time.strftime('%I:%M %p') %> - 
                                <%= availability.end_time.strftime('%I:%M %p') %>
                              </small>
                            </td>
                            <td>
                              <% if availability.available? %>
                                <span class="badge bg-success">Available</span>
                              <% else %>
                                <span class="badge bg-danger">Unavailable</span>
                              <% end %>
                            </td>
                            <td>
                              <div class="btn-group btn-group-sm" role="group">
                                <%= link_to "Edit", edit_admin_availability_path(availability), 
                                            class: "btn btn-outline-primary btn-sm" %>
                                <%= link_to "Delete", admin_availability_path(availability), 
                                            method: :delete, 
                                            class: "btn btn-outline-danger btn-sm",
                                            confirm: "Are you sure?" %>
                              </div>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  </div>
                <% else %>
                  <p class="text-muted mb-0">
                    No availability slots defined.
                    <%= link_to "Add the first one", new_teacher_availability_admin_availabilities_path(teacher_id: teacher.id), 
                                class: "btn btn-sm btn-outline-primary" %>
                  </p>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if @teachers.empty? %>
        <div class="alert alert-info">
          <h4>No Teachers Found</h4>
          <p class="mb-0">
            You need to create teachers first before managing their availability.
            <%= link_to "Go to Teachers", admin_teachers_path, class: "btn btn-primary" %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
