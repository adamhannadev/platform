<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Availability Details</h1>
        <div>
          <%= link_to "Edit", edit_admin_availability_path(@availability), class: "btn btn-primary" %>
          <%= link_to "Back to #{@availability.available_for.class.name} Availability", 
                      polymorphic_path([:admin, @availability.available_for, :availabilities]), 
                      class: "btn btn-outline-secondary" %>
        </div>
      </div>
      
      <div class="row">
        <div class="col-md-8">
          <div class="card">
            <div class="card-header">
              <h5>Availability Information</h5>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <strong>Date:</strong>
                  <p class="text-muted"><%= @availability.start_time.strftime("%A, %B %d, %Y") %></p>
                </div>
                <div class="col-md-6">
                  <strong>Day of Week:</strong>
                  <p class="text-muted"><%= @availability.start_time.strftime("%A") %></p>
                </div>
                <div class="col-md-6">
                  <strong>Start Time:</strong>
                  <p class="text-muted"><%= @availability.start_time.strftime("%I:%M %p") %></p>
                </div>
                <div class="col-md-6">
                  <strong>End Time:</strong>
                  <p class="text-muted"><%= @availability.end_time.strftime("%I:%M %p") %></p>
                </div>
                <div class="col-md-6">
                  <strong>Duration:</strong>
                  <p class="text-muted">
                    <% duration = ((@availability.end_time - @availability.start_time) / 1.hour).round(1) %>
                    <%= "#{duration} hour#{'s' if duration != 1}" %>
                  </p>
                </div>
                <div class="col-md-6">
                  <strong>Status:</strong>
                  <p>
                    <% if @availability.start_time > Time.current %>
                      <span class="badge bg-success">Upcoming</span>
                    <% elsif @availability.end_time < Time.current %>
                      <span class="badge bg-secondary">Past</span>
                    <% else %>
                      <span class="badge bg-warning">Current</span>
                    <% end %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-4">
          <div class="card">
            <div class="card-header">
              <h5><%= @availability.available_for.class.name %> Details</h5>
            </div>
            <div class="card-body">
              <h6><%= @availability.available_for.name %></h6>
              
              <% if @availability.available_for.respond_to?(:email) && @availability.available_for.email.present? %>
                <p class="text-muted mb-1">
                  <i class="fas fa-envelope"></i> <%= @availability.available_for.email %>
                </p>
              <% end %>
              
              <% if @availability.available_for.respond_to?(:phone) && @availability.available_for.phone.present? %>
                <p class="text-muted mb-1">
                  <i class="fas fa-phone"></i> <%= @availability.available_for.phone %>
                </p>
              <% end %>
              
              <% if @availability.available_for.respond_to?(:address) && @availability.available_for.address.present? %>
                <p class="text-muted mb-1">
                  <i class="fas fa-map-marker-alt"></i> <%= @availability.available_for.address %>
                </p>
              <% end %>
              
              <% if @availability.available_for.respond_to?(:rate) && @availability.available_for.rate.present? %>
                <p class="text-muted mb-1">
                  <i class="fas fa-dollar-sign"></i> $<%= number_with_precision(@availability.available_for.rate, precision: 2) %>/hour
                </p>
              <% end %>
              
              <div class="mt-3">
                <%= link_to "View #{@availability.available_for.class.name}", 
                            polymorphic_path([:admin, @availability.available_for]), 
                            class: "btn btn-sm btn-outline-primary" %>
              </div>
            </div>
          </div>
          
          <div class="card mt-3">
            <div class="card-header">
              <h6>Quick Actions</h6>
            </div>
            <div class="card-body">
              <%= link_to "Edit Availability", edit_admin_availability_path(@availability), 
                          class: "btn btn-sm btn-outline-secondary d-block mb-2" %>
              <%= link_to "View All #{@availability.available_for.class.name} Availability", 
                          polymorphic_path([:admin, @availability.available_for, :availabilities]), 
                          class: "btn btn-sm btn-outline-info d-block mb-2" %>
              <%= link_to "Delete Availability", admin_availability_path(@availability), 
                          method: :delete, confirm: "Are you sure?", 
                          class: "btn btn-sm btn-outline-danger d-block" %>
            </div>
          </div>
        </div>
      </div>

      <% lessons = Lesson.where(
           teacher: (@availability.available_for if @availability.available_for.is_a?(Teacher)),
           location: (@availability.available_for if @availability.available_for.is_a?(Location))
         ).where(
           'start_time >= ? AND start_time < ?', 
           @availability.start_time, 
           @availability.end_time
         ) %>
      
      <% if lessons.any? %>
        <div class="row mt-4">
          <div class="col-12">
            <div class="card">
              <div class="card-header">
                <h5>Lessons During This Availability</h5>
              </div>
              <div class="card-body">
                <div class="table-responsive">
                  <table class="table table-sm">
                    <thead>
                      <tr>
                        <th>Date/Time</th>
                        <th>Student</th>
                        <th>Teacher</th>
                        <th>Location</th>
                        <th>Duration</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% lessons.each do |lesson| %>
                        <tr>
                          <td><%= lesson.start_time.strftime("%m/%d/%Y %I:%M %p") %></td>
                          <td><%= lesson.student.full_name %></td>
                          <td><%= lesson.teacher.name %></td>
                          <td><%= lesson.location.name %></td>
                          <td><%= lesson.duration %> min</td>
                          <td>
                            <%= link_to "View", admin_lesson_path(lesson), class: "btn btn-xs btn-outline-primary" %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
