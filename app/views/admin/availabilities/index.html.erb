<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Availability Management</h1>
        <div class="btn-group" role="group">
          <%= link_to "Teacher Availability", teacher_availability_admin_availabilities_path, 
                      class: "btn btn-primary" %>
          <%= link_to "Location Availability", location_availability_admin_availabilities_path, 
                      class: "btn btn-success" %>
        </div>
      </div>

      <!-- Quick Access Cards -->
      <div class="row mb-4">
        <div class="col-md-6">
          <div class="card border-primary">
            <div class="card-header bg-primary text-white">
              <h5 class="mb-0">
                <i class="fas fa-user-tie me-2"></i>
                Teacher Availability
              </h5>
            </div>
            <div class="card-body">
              <p class="card-text">Manage when teachers are available for lessons.</p>
              <div class="d-flex gap-2">
                <%= link_to "View Teachers", teacher_availability_admin_availabilities_path, 
                            class: "btn btn-primary" %>
                <%= link_to "Add Teacher Availability", new_teacher_availability_admin_availabilities_path, 
                            class: "btn btn-outline-primary" %>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-6">
          <div class="card border-success">
            <div class="card-header bg-success text-white">
              <h5 class="mb-0">
                <i class="fas fa-map-marker-alt me-2"></i>
                Location Availability
              </h5>
            </div>
            <div class="card-body">
              <p class="card-text">Manage when locations are available for bookings.</p>
              <div class="d-flex gap-2">
                <%= link_to "View Locations", location_availability_admin_availabilities_path, 
                            class: "btn btn-success" %>
                <%= link_to "Add Location Availability", new_location_availability_admin_availabilities_path, 
                            class: "btn btn-outline-success" %>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <% if @parent.nil? %>
        <div class="row mb-4">
          <div class="col-md-6">
            <div class="card">
              <div class="card-header">
                <h6>Filter by Teacher</h6>
              </div>
              <div class="card-body">
                <% if @teachers.any? %>
                  <% @teachers.each do |teacher| %>
                    <%= link_to teacher.name, admin_teacher_availabilities_path(teacher), 
                                class: "btn btn-sm btn-outline-info me-2 mb-2" %>
                  <% end %>
                <% else %>
                  <p class="text-muted mb-0">No teachers with availability</p>
                <% end %>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card">
              <div class="card-header">
                <h6>Filter by Location</h6>
              </div>
              <div class="card-body">
                <% if @locations.any? %>
                  <% @locations.each do |location| %>
                    <%= link_to location.name, admin_location_availabilities_path(location), 
                                class: "btn btn-sm btn-outline-success me-2 mb-2" %>
                  <% end %>
                <% else %>
                  <p class="text-muted mb-0">No locations with availability</p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
      
      <div class="card">
        <div class="card-body">
          <% if @availabilities.any? %>
            <div class="table-responsive">
              <table class="table table-striped">
                <thead>
                  <tr>
                    <% unless @parent %>
                      <th>Type</th>
                      <th>Name</th>
                    <% end %>
                    <th>Date</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Duration</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @availabilities.each do |availability| %>
                    <tr>
                      <% unless @parent %>
                        <td>
                          <span class="badge bg-<%= availability.available_for.is_a?(Teacher) ? 'info' : 'success' %>">
                            <%= availability.available_for.class.name %>
                          </span>
                        </td>
                        <td>
                          <%= link_to availability.available_for.name, 
                                      polymorphic_path([:admin, availability.available_for]), 
                                      class: "text-decoration-none" %>
                        </td>
                      <% end %>
                      <td><%= availability.start_time.strftime("%A, %B %d, %Y") %></td>
                      <td><%= availability.start_time.strftime("%I:%M %p") %></td>
                      <td><%= availability.end_time.strftime("%I:%M %p") %></td>
                      <td>
                        <% duration = ((availability.end_time - availability.start_time) / 1.hour).round(1) %>
                        <%= "#{duration} hour#{'s' if duration != 1}" %>
                      </td>
                      <td>
                        <%= link_to "View", admin_availability_path(availability), class: "btn btn-sm btn-outline-primary" %>
                        <%= link_to "Edit", edit_admin_availability_path(availability), class: "btn btn-sm btn-outline-secondary" %>
                        <%= link_to "Delete", admin_availability_path(availability), method: :delete, 
                                    confirm: "Are you sure?", class: "btn btn-sm btn-outline-danger" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-center py-5">
              <h4 class="text-muted">No availability slots found</h4>
              <% if @parent %>
                <p>Create availability slots to allow bookings for this <%= @parent.class.name.downcase %>.</p>
                <%= link_to "Add First Availability", new_polymorphic_path([:admin, @parent, :availabilities]), class: "btn btn-primary" %>
              <% else %>
                <p>No availability slots have been created yet.</p>
                <div>
                  <%= link_to "Manage Teacher Availability", admin_teachers_path, class: "btn btn-primary me-2" %>
                  <%= link_to "Manage Location Availability", admin_locations_path, class: "btn btn-primary" %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
