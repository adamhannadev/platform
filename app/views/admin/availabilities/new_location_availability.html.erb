<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
          <i class="fas fa-map-marker-alt me-2"></i>
          Add Location Availability
        </h1>
        <div>
          <%= link_to "Location Availability", location_availability_admin_availabilities_path, 
                      class: "btn btn-outline-secondary" %>
        </div>
      </div>

      <div class="row">
        <div class="col-md-8">
          <div class="card">
            <div class="card-header">
              <h5 class="mb-0">New Availability Slot</h5>
            </div>
            <div class="card-body">
              <%= form_with model: @availability, url: create_location_availability_admin_availabilities_path, 
                            local: true, class: "needs-validation", novalidate: true do |form| %>
                
                <% if @availability.errors.any? %>
                  <div class="alert alert-danger">
                    <h6>Please fix the following errors:</h6>
                    <ul class="mb-0">
                      <% @availability.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <!-- Location Selection -->
                <div class="mb-3">
                  <%= form.label :available_for_id, "Location", class: "form-label" %>
                  <%= form.select :available_for_id, 
                                  options_from_collection_for_select(@locations, :id, :name, @availability.available_for_id), 
                                  { prompt: "Select a location..." }, 
                                  { class: "form-select", required: true } %>
                  <div class="invalid-feedback">
                    Please select a location.
                  </div>
                </div>

                <%= form.hidden_field :available_for_type, value: "Location" %>

                <!-- Date and Time Range -->
                <div class="row">
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= form.label :start_time, "Start Date & Time", class: "form-label" %>
                      <%= form.datetime_local_field :start_time, 
                                                    class: "form-control", 
                                                    required: true %>
                      <div class="invalid-feedback">
                        Please enter a start date and time.
                      </div>
                      <div class="form-text">
                        Set the date and start time for this availability slot.
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= form.label :end_time, "End Date & Time", class: "form-label" %>
                      <%= form.datetime_local_field :end_time, 
                                                  class: "form-control", 
                                                  required: true %>
                      <div class="invalid-feedback">
                        Please enter an end date and time.
                      </div>
                      <div class="form-text">
                        Set the date and end time for this availability slot.
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Availability Status -->
                <div class="mb-3">
                  <div class="form-check">
                    <%= form.check_box :available, class: "form-check-input", checked: true %>
                    <%= form.label :available, "Available for booking", class: "form-check-label" %>
                  </div>
                  <div class="form-text">
                    Uncheck if this time slot should be blocked (location unavailable).
                  </div>
                </div>

                <!-- Submit Buttons -->
                <div class="d-flex gap-2">
                  <%= form.submit "Create Availability", class: "btn btn-success" %>
                  <%= link_to "Cancel", location_availability_admin_availabilities_path, 
                              class: "btn btn-outline-secondary" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Quick Reference -->
        <div class="col-md-4">
          <div class="card">
            <div class="card-header">
              <h6 class="mb-0">
                <i class="fas fa-lightbulb me-1"></i>
                Quick Tips
              </h6>
            </div>
            <div class="card-body">
              <ul class="list-unstyled small">
                <li class="mb-2">
                  <i class="fas fa-clock text-success me-2"></i>
                  Use datetime picker to set specific dates and times
                </li>
                <li class="mb-2">
                  <i class="fas fa-calendar text-primary me-2"></i>
                  Set availability for specific dates
                </li>
                <li class="mb-2">
                  <i class="fas fa-ban text-warning me-2"></i>
                  Block slots during maintenance/cleaning
                </li>
                <li class="mb-0">
                  <i class="fas fa-copy text-info me-2"></i>
                  Create consistent schedules
                </li>
              </ul>
            </div>
          </div>

          <% if @selected_location&.availabilities&.any? %>
            <div class="card mt-3">
              <div class="card-header">
                <h6 class="mb-0">
                  <i class="fas fa-list me-1"></i>
                  <%= @selected_location.name %>'s Current Availability
                </h6>
              </div>
              <div class="card-body">
                <div class="small">
                  <% @selected_location.availabilities.order(:start_time).each do |availability| %>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span>
                        <span class="badge bg-secondary me-1">
                          <%= availability.start_time.strftime('%m/%d') %>
                        </span>
                        <%= availability.start_time.strftime('%I:%M %p') %>-<%= availability.end_time.strftime('%I:%M %p') %>
                      </span>
                      <span class="badge <%= availability.available? ? 'bg-success' : 'bg-danger' %>">
                        <%= availability.available? ? 'Available' : 'Blocked' %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Bootstrap form validation
(function() {
  'use strict';
  window.addEventListener('load', function() {
    var forms = document.getElementsByClassName('needs-validation');
    var validation = Array.prototype.filter.call(forms, function(form) {
      form.addEventListener('submit', function(event) {
        if (form.checkValidity() === false) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  }, false);
})();
</script>
