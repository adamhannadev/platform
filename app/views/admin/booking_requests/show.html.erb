<% content_for :title, "Booking Request Details" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Booking Request Details</h1>
  <%= link_to "← Back to Requests", admin_booking_requests_path, class: "btn btn-outline-secondary" %>
</div>

<div class="row">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Request Information</h5>
        <span class="badge bg-<%= @booking_request.status == 'pending' ? 'warning' : 
                                  @booking_request.status == 'approved' ? 'success' : 'danger' %> fs-6">
          <%= @booking_request.status.titleize %>
        </span>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <h6 class="text-muted">Student Information</h6>
            <p class="mb-1"><strong><%= @booking_request.student.full_name %></strong></p>
            <p class="mb-1 text-muted"><%= @booking_request.student.email %></p>
            <% if @booking_request.student.phone.present? %>
              <p class="mb-3 text-muted"><%= @booking_request.student.phone %></p>
            <% end %>
            
            <h6 class="text-muted">Teacher Information</h6>
            <p class="mb-1"><strong><%= @booking_request.teacher.full_name %></strong></p>
            <p class="mb-1 text-muted"><%= @booking_request.teacher.email %></p>
            <% if @booking_request.teacher.hourly_rate.present? %>
              <p class="mb-3 text-muted">Rate: $<%= @booking_request.teacher.hourly_rate %>/hour</p>
            <% end %>
          </div>
          
          <div class="col-md-6">
            <h6 class="text-muted">Lesson Details</h6>
            <p class="mb-1"><strong>Date:</strong> <%= @booking_request.requested_date.strftime('%A, %B %-d, %Y') %></p>
            <p class="mb-1"><strong>Time:</strong> <%= @booking_request.requested_time.strftime('%-I:%M %p') %></p>
            <p class="mb-1"><strong>Duration:</strong> <%= @booking_request.duration %> minutes</p>
            <p class="mb-3"><strong>Location:</strong> <%= @booking_request.location.name %></p>
            
            <h6 class="text-muted">Request Timeline</h6>
            <p class="mb-1"><strong>Requested:</strong> <%= @booking_request.created_at.strftime('%B %-d, %Y at %-I:%M %p') %></p>
            <% if @booking_request.approved_at.present? %>
              <p class="mb-1 text-success"><strong>Approved:</strong> <%= @booking_request.approved_at.strftime('%B %-d, %Y at %-I:%M %p') %></p>
              <p class="mb-1 text-success"><strong>Approved by:</strong> <%= @booking_request.approved_by&.full_name %></p>
            <% elsif @booking_request.rejected_at.present? %>
              <p class="mb-1 text-danger"><strong>Rejected:</strong> <%= @booking_request.rejected_at.strftime('%B %-d, %Y at %-I:%M %p') %></p>
              <p class="mb-1 text-danger"><strong>Rejected by:</strong> <%= @booking_request.rejected_by&.full_name %></p>
            <% end %>
          </div>
        </div>
        
        <% if @booking_request.notes.present? %>
          <div class="mt-3">
            <h6 class="text-muted">Student Notes</h6>
            <div class="alert alert-light">
              <%= simple_format(@booking_request.notes) %>
            </div>
          </div>
        <% end %>
        
        <% if @booking_request.rejection_reason.present? %>
          <div class="mt-3">
            <h6 class="text-muted">Rejection Reason</h6>
            <div class="alert alert-danger">
              <%= simple_format(@booking_request.rejection_reason) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    
    <% if @booking_request.lesson.present? %>
      <div class="card mt-4">
        <div class="card-header">
          <h5 class="mb-0">Associated Lesson</h5>
        </div>
        <div class="card-body">
          <p class="mb-1"><strong>Lesson ID:</strong> #<%= @booking_request.lesson.id %></p>
          <p class="mb-1"><strong>Status:</strong> 
            <span class="badge bg-<%= @booking_request.lesson.status == 'scheduled' ? 'primary' : 
                                    @booking_request.lesson.status == 'completed' ? 'success' : 
                                    @booking_request.lesson.status == 'cancelled' ? 'danger' : 'secondary' %>">
              <%= @booking_request.lesson.status.titleize %>
            </span>
          </p>
          <p class="mb-1"><strong>Start Time:</strong> <%= @booking_request.lesson.start_time.strftime('%B %-d, %Y at %-I:%M %p') %></p>
          <p class="mb-3"><strong>End Time:</strong> <%= @booking_request.lesson.end_time.strftime('%B %-d, %Y at %-I:%M %p') %></p>
          
          <%= link_to "View Lesson Details", admin_lesson_path(@booking_request.lesson), 
                      class: "btn btn-outline-primary" %>
        </div>
      </div>
    <% end %>
  </div>
  
  <div class="col-lg-4">
    <% if @booking_request.status == 'pending' %>
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Actions</h5>
        </div>
        <div class="card-body">
          <p class="text-muted mb-3">Choose an action for this booking request:</p>
          
          <%= button_to "Approve Request", approve_admin_booking_request_path(@booking_request), 
                        method: :patch, 
                        class: "btn btn-success w-100 mb-2",
                        data: { confirm: "Are you sure you want to approve this booking request? This will create a new lesson." } %>
          
          <%= button_to "Reject Request", reject_admin_booking_request_path(@booking_request), 
                        method: :patch, 
                        class: "btn btn-danger w-100",
                        data: { confirm: "Are you sure you want to reject this booking request?" } %>
        </div>
      </div>
    <% end %>
    
    <div class="card mt-3">
      <div class="card-header">
        <h5 class="mb-0">Availability Check</h5>
      </div>
      <div class="card-body">
        <% teacher_available = @booking_request.teacher_available_at_time? %>
        <% location_available = @booking_request.location_available_at_time? %>
        
        <div class="mb-2">
          <span class="badge bg-<%= teacher_available ? 'success' : 'danger' %> me-2">
            <%= teacher_available ? '✓' : '✗' %>
          </span>
          Teacher <%= teacher_available ? 'Available' : 'Not Available' %>
        </div>
        
        <div class="mb-2">
          <span class="badge bg-<%= location_available ? 'success' : 'danger' %> me-2">
            <%= location_available ? '✓' : '✗' %>
          </span>
          Location <%= location_available ? 'Available' : 'Not Available' %>
        </div>
        
        <% if !teacher_available || !location_available %>
          <div class="alert alert-warning mt-3">
            <small><i class="fas fa-exclamation-triangle me-1"></i>
            Conflicts detected. Please verify availability before approving.</small>
          </div>
        <% end %>
      </div>
    </div>
    
    <div class="card mt-3">
      <div class="card-header">
        <h5 class="mb-0">Quick Stats</h5>
      </div>
      <div class="card-body">
        <p class="mb-1"><strong>Student's Total Lessons:</strong> <%= @booking_request.student.lessons.count %></p>
        <p class="mb-1"><strong>Teacher's Total Lessons:</strong> <%= @booking_request.teacher.lessons.count %></p>
        <p class="mb-0"><strong>Location Usage:</strong> <%= @booking_request.location.lessons.count %> lessons</p>
      </div>
    </div>
  </div>
</div>
