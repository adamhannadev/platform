<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Edit Teacher</h1>
        <div>
          <%= link_to "View", admin_teacher_path(@teacher), class: "btn btn-outline-primary" %>
          <%= link_to "Back to Teachers", admin_teachers_path, class: "btn btn-outline-secondary" %>
        </div>
      </div>
      
      <div class="card">
        <div class="card-body">
          <%= form_with model: [:admin, @teacher], local: true, html: { class: "row g-3" } do |form| %>
            <% if @teacher.errors.any? %>
              <div class="col-12">
                <div class="alert alert-danger">
                  <h4><%= pluralize(@teacher.errors.count, "error") %> prohibited this teacher from being saved:</h4>
                  <ul class="mb-0">
                    <% @teacher.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            <% end %>

            <div class="col-12">
              <h5>Teacher Information</h5>
            </div>

            <div class="col-md-6">
              <%= form.label :first_name, class: "form-label" %>
              <%= form.text_field :first_name, class: "form-control" %>
            </div>

            <div class="col-md-6">
              <%= form.label :last_name, class: "form-label" %>
              <%= form.text_field :last_name, class: "form-control" %>
            </div>

            <div class="col-md-6">
              <%= form.label :phone, class: "form-label" %>
              <%= form.telephone_field :phone, class: "form-control" %>
            </div>

            <div class="col-md-6">
              <%= form.label :email, class: "form-label" %>
              <%= form.email_field :email, class: "form-control" %>
            </div>

            <% if @teacher.user.present? %>
              <%= form.fields_for :user do |user_form| %>
                <div class="col-12 mt-4">
                  <h5>User Account</h5>
                  <div class="alert alert-info">
                    This teacher has a linked user account. Leave password fields blank to keep current password.
                  </div>
                </div>

                <%= user_form.hidden_field :id %>

                <div class="col-md-6">
                  <%= user_form.label :email, class: "form-label" %>
                  <%= user_form.email_field :email, class: "form-control" %>
                </div>

                <div class="col-md-6">
                  <%= user_form.label :role, class: "form-label" %>
                  <%= user_form.select :role, [['Student', 'student'], ['Teacher', 'teacher'], ['Admin', 'admin']], 
                                      {}, { class: "form-select" } %>
                </div>

                <div class="col-md-6">
                  <%= user_form.label :password, "New Password (leave blank to keep current)", class: "form-label" %>
                  <%= user_form.password_field :password, class: "form-control" %>
                </div>

                <div class="col-md-6">
                  <%= user_form.label :password_confirmation, class: "form-label" %>
                  <%= user_form.password_field :password_confirmation, class: "form-control" %>
                </div>
              <% end %>
            <% else %>
              <div class="col-12 mt-4">
                <div class="alert alert-warning">
                  This teacher doesn't have a user account. You can create one by going to the Users section.
                </div>
              </div>
            <% end %>

            <div class="col-12">
              <%= form.submit "Update Teacher", class: "btn btn-primary" %>
              <%= link_to "Cancel", admin_teacher_path(@teacher), class: "btn btn-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
