<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Figures</h1>
        <%= link_to "New Figure", new_admin_figure_path, class: "btn btn-primary" %>
      </div>
      
      <div class="card">
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped">
              <thead>
                <tr>
                  <th>Dance</th>
                  <th>Number</th>
                  <th>Name</th>
                  <th>Bars</th>
                  <th>Level</th>
                  <th>Core</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @figures.each do |figure| %>
                  <tr>
                    <td>
                      <span class="badge bg-<%= 
                        case figure.dance&.downcase
                        when 'waltz' then 'primary'
                        when 'tango' then 'danger'
                        when 'foxtrot' then 'success'
                        else 'secondary'
                        end
                      %>">
                        <%= figure.dance %>
                      </span>
                    </td>
                    <td><%= figure.number %></td>
                    <td><%= figure.name %></td>
                    <td><%= figure.bars %></td>
                    <td>
                      <% if figure.level.present? %>
                        <span class="badge bg-info"><%= figure.level %></span>
                      <% else %>
                        <span class="text-muted">-</span>
                      <% end %>
                    </td>
                    <td>
                      <% if figure.core? %>
                        <span class="badge bg-warning">Core</span>
                      <% else %>
                        <span class="text-muted">-</span>
                      <% end %>
                    </td>
                    <td>
                      <%= link_to "View", admin_figure_path(figure), class: "btn btn-sm btn-outline-primary" %>
                      <%= link_to "Edit", edit_admin_figure_path(figure), class: "btn btn-sm btn-outline-secondary" %>
                      <%= link_to "Delete", admin_figure_path(figure), method: :delete, 
                                  confirm: "Are you sure?", class: "btn btn-sm btn-outline-danger" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
