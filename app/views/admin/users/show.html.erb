<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>User Details</h1>
        <div>
          <%= link_to "Edit", edit_admin_user_path(@user), class: "btn btn-primary" %>
          <%= link_to "Back to Users", admin_users_path, class: "btn btn-secondary" %>
        </div>
      </div>
      
      <div class="card">
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <h5>Email</h5>
              <p class="text-muted"><%= @user.email %></p>
            </div>
            <div class="col-md-6">
              <h5>Role</h5>
              <p>
                <span class="badge bg-<%= @user.role == 'admin' ? 'danger' : @user.role == 'teacher' ? 'info' : 'success' %> fs-6">
                  <%= @user.role.titleize %>
                </span>
              </p>
            </div>
          </div>
          
          <div class="row mt-3">
            <div class="col-md-6">
              <h5>Created</h5>
              <p class="text-muted"><%= @user.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
            </div>
            <div class="col-md-6">
              <h5>Last Updated</h5>
              <p class="text-muted"><%= @user.updated_at.strftime("%B %d, %Y at %I:%M %p") %></p>
            </div>
          </div>
          
          <% if @user.student.present? %>
            <div class="row mt-3">
              <div class="col-12">
                <h5>Student Profile</h5>
                <p><%= link_to @user.student.full_name, admin_student_path(@user.student), class: "btn btn-sm btn-outline-success" %></p>
              </div>
            </div>
          <% end %>
          
          <% if @user.teacher.present? %>
            <div class="row mt-3">
              <div class="col-12">
                <h5>Teacher Profile</h5>
                <p><%= link_to @user.teacher.full_name, admin_teacher_path(@user.teacher), class: "btn btn-sm btn-outline-info" %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
