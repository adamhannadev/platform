<turbo-stream target="toast-container" action="append">
  <template>
    <div class="toast show align-items-center text-bg-primary border-0 mb-2" role="alert" aria-live="assertive" aria-atomic="true" data-controller="toast">
      <div class="d-flex">
        <div class="toast-body">
          <%= message %>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-action="click->toast#close" aria-label="Close"></button>
      </div>
    </div>
  </template>
</turbo-stream>