<div id="messages" style="position: fixed; top: 1rem; left: 0; width: 100%; z-index: 9999;" class="d-flex justify-content-center"></div>

<turbo-stream target="messages" action="append">
  <template>
    <div class="alert alert-info alert-dismissible fade show mb-2 mt-2" role="alert">
      <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </template>
</turbo-stream>