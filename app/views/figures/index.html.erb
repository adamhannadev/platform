<p style="color: green"><%= notice %></p>

<% content_for :title, "Figures" %>

<h1>Figures</h1>

<table id="figures">
  <thead>
    <th></th>
    <th>Name</th>
    <th>Variations</th>
  </thead>
  <tbody>

    <% levels = ["Bronze 1", "Bronze 2", "Bronze 3", "Bronze 4"] %>
    <% levels.each do |l| %>
    <% bronze_figures = @figures.select { |f| f.level == l } %>
    <% bronze_figures.each_with_index do |f, i| %>
      <tr class="<%= 'core' if f.core %>">
        <% if i == 0 %>
          <td rowspan="<%= bronze_figures.size %>" class="vertical-label"><%= l %></td>
        <% end %>
        <td><%="#{f.number}. #{f.name}" if f.core %></td>
        <td><%= "#{f.number}. #{f.name}" unless f.core %></td>
      </tr>
    <% end %>
    <% end %>
  </tbody>
</table>

<%= link_to "New figure", new_figure_path %>

<style>
  #figures {
    border: 1px solid black;
  }
  .core {
    font-weight: bold;
  }
  .vertical-label {
    writing-mode: vertical-rl;
    text-align: center;
    font-weight: bold;
    background: #f0f0f0;
  }
</style>
