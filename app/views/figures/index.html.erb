<p style="color: green"><%= notice %></p>

<% content_for :title, "Figures" %>

<h1>Foxtrot Figures</h1>

<table id="figures">
  <thead>
    <th>Core Figure</th>
  </thead>
  <tbody>
    <tr>
      <td>something</td>
    </tr>
  </tbody>
</table>

<%= link_to "New figure", new_figure_path %>

<style>
  #figures {
    border: 1px solid black;
    width: 80%;
    margin-left: auto;
    margin-right: auto;
  }
    #figures th, #figures td {
    border: 1px solid black;
  }
  #figures tr {
    border: 1px solid black;
  }
  .core {
    font-weight: bold;
  }
  .vertical-label {
    writing-mode: vertical-rl;
    text-align: center;
    font-weight: bold;
    background: #f0f0f0;
    border-radius: 20% 0% 0% 20%;
  }
</style>


