<div id="<%= dom_id figure %>">
  <p>
    <strong>Name:</strong>
    <%= figure.name %>
  </p>

  <p>
    <strong>Dance:</strong>
    <%= figure.dance %>
  </p>

  <p>
    <strong>Number:</strong>
    <%= figure.number %>
  </p>

  <p>
    <strong>Bars:</strong>
    <%= figure.bars %>
  </p>

  <p>
    <strong>Components:</strong>
    <%= figure.components %>
  </p>

  <p>
    <strong>Core:</strong>
    <%= figure.core %>
  </p>

</div>
