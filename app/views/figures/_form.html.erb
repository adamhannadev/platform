<%= form_with(model: figure) do |form| %>
  <% if figure.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(figure.errors.count, "error") %> prohibited this figure from being saved:</h2>

      <ul>
        <% figure.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :dance, style: "display: block" %>
    <%= form.text_field :dance %>
  </div>

  <div>
    <%= form.label :number, style: "display: block" %>
    <%= form.text_field :number %>
  </div>

  <div>
    <%= form.label :bars, style: "display: block" %>
    <%= form.number_field :bars %>
  </div>

  <div>
    <%= form.label :components, style: "display: block" %>
    <%= form.text_area :components %>
  </div>

  <div>
    <%= form.label :core, style: "display: block" %>
    <%= form.check_box :core %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
