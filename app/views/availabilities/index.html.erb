<p style="color: green"><%= notice %></p>

<% content_for :title, "Availabilities" %>

<h1>
  <% if defined?(@teacher) && @teacher %>
    Availabilities for <%= @teacher.full_name %>
  <% elsif defined?(@location) && @location %>
    Availabilities for <%= @location.name %>
  <% else %>
    All Availabilities
  <% end %>
</h1>

<%# Month navigation links %>
<% if defined?(@teacher) && @teacher %>
  <%= link_to "Previous Month", month_teacher_availabilities_path(@teacher, (@first_day - 1.month).strftime("%Y-%m")) %> |
  <%= link_to "Next Month", month_teacher_availabilities_path(@teacher, (@first_day + 1.month).strftime("%Y-%m")) %>
<% elsif defined?(@location) && @location %>
  <%= link_to "Previous Month", month_location_availabilities_path(@location, (@first_day - 1.month).strftime("%Y-%m")) %> |
  <%= link_to "Next Month", month_location_availabilities_path(@location, (@first_day + 1.month).strftime("%Y-%m")) %>
<% else %>
  <%= link_to "Previous Month", availabilities_month_path((@first_day - 1.month).strftime("%Y-%m")) %> |
  <%= link_to "Next Month", availabilities_month_path((@first_day + 1.month).strftime("%Y-%m")) %>
<% end %>

<%= render "calendar", days: @days, availabilities: @availabilities %>

<div id="availabilities">
  <% @availabilities.each do |availability| %>
    <%= render availability %>
    <p>
      <%= link_to "Show this availability", availability %>
    </p>
  <% end %>
</div>

<%= link_to "New availability", new_availability_path %>
