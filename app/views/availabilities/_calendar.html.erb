<table>
  <tr>
    <% Date::ABBR_DAYNAMES.each do |day| %>
      <th><%= day %></th>
    <% end %>
  </tr>
  <% @days.in_groups_of(7, false) do |week| %>
    <tr>
      <% week.each do |date| %>
        <td style="vertical-align: top;">
          <strong><%= date.day %></strong>
          <% @availabilities.select { |a| a.start_time.to_date == date }.each do |a| %>
            <div>
              <%= link_to "#{a.available_for_type}/#{a.available_for_id}", availability_path(a) %><br>
              <%= a.start_time.strftime("%I:%M %p") %> - <%= a.end_time.strftime("%I:%M %p") %>
            </div>
          <% end %>
        </td>
      <% end %>
    </tr>
  <% end %>
</table>