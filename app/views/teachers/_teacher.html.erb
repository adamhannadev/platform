<div id="<%= dom_id teacher %>">
  <p>
    <strong>Last name:</strong>
    <%= teacher.last_name %>
  </p>

  <p>
    <strong>First name:</strong>
    <%= teacher.first_name %>
  </p>

  <p>
    <strong>Phone:</strong>
    <%= teacher.phone %>
  </p>

  <p>
    <strong>Email:</strong>
    <%= teacher.email %>
  </p>

</div>
<%= link_to "View Schedule", schedule_teacher_path(@teacher, date: Date.today) %>
<%= link_to "View Availabilities", teacher_availabilities_path(@teacher) %>
