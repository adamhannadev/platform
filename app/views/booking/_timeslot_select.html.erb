<turbo-frame id="booking-flow">
  <div class="card shadow-sm p-4">
    <h2 class="mb-4 text-center">Choose a Timeslot</h2>
    <div class="d-flex flex-wrap gap-2 justify-content-center mb-3">
      <% timeslots.each do |slot| %>
        <%= button_to slot.strftime("%I:%M %p"),
          lessons_path,
          method: :post,
          params: { location_id: location.id, teacher_id: teacher.id, start_time: slot },
          form: { data: { turbo_frame: "booking-flow" }, class: "d-inline" },
          class: "btn btn-success btn-lg" %>
      <% end %>
    </div>
  </div>
</turbo-frame>